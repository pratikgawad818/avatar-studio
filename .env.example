# ═════════════════════════════════════════════════════════════════
# Avatar Studio - Environment Configuration
# ═════════════════════════════════════════════════════════════════

# App Settings
DEBUG=False
APP_VERSION=3.0.0

# Server
HOST=0.0.0.0
PORT=8002
RELOAD=False

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./avatar_studio.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/avatar_studio

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Storage
BASE_DIR=.
AVATARS_DIR=./data/avatars
VOICES_DIR=./data/voices
BACKGROUNDS_DIR=./data/backgrounds
OUTPUTS_DIR=./data/outputs
TEMP_DIR=./data/temp

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=3600

# AI Models
WHISPER_MODEL=base
F5TTS_MODEL_DIR=./models/F5-TTS
WAV2LIP_CHECKPOINT=./models/Wav2Lip/checkpoints/wav2lip_gan.pth

# Feature Flags
ENABLE_VOICE_CLONING=True
ENABLE_BATCH_PROCESSING=True
ENABLE_BACKGROUND_REMOVAL=True
